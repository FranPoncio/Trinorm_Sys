 * La herramienta: una organización propia, su entrevista, sus documentos y
 * su ruta de certificación.
 *
 * Es una sola página con rutas por hash (`#/o/<id>/documentos`). En un sitio
 * estático no se pueden generar páginas para organizaciones que no existen
 * hasta que alguien las carga, así que el cliente decide qué dibujar.
 */
import Herramienta from '../../layouts/Herramienta.astro';
